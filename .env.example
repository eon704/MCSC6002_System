# Copy to .env and replace the values. .env is git-ignored.
# SQL Server requires 8+ chars with upper, lower, digit and symbol.
SQL_SA_PASSWORD=
RABBITMQ_USER=mcsc6002
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
# HMAC key for RabbitMQ events, base64 of 32+ random bytes: openssl rand -base64 32
MESSAGE_SIGNING_KEY=
# Seeded IdentityService users (min 12 chars, 6 unique).
SEED_ADMIN_PASSWORD=
SEED_BASIC_PASSWORD=
