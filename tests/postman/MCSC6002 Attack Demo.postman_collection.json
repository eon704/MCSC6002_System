    {
      "name": "2 Token attacks",
      "description": "Each request attacks the token or the permission check. All must fail.",
      "item": [
        {
          "name": "No token (A1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/product-service/products/all",
            "description": "Protected route without a token.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Basic user creates a product (A7)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/product-service/products/create",
            "description": "Route needs Permission.Product.Products.Create; the gateway refuses before Product is called.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{basicToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"brandId\": {{brandId}}, \"name\": \"Postman widget\", \"description\": \"attack demo\", \"quantity\": 3, \"reOrderThreshold\": 1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Edited token: add Create permission (A2)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "const CryptoJS = require('crypto-js');",
                  "const dec = s => CryptoJS.enc.Base64.parse(s.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((s.length + 3) % 4)).toString(CryptoJS.enc.Utf8);",
                  "const url = b => b.replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const enc = s => url(CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(s)));",
                  "const [h, p, s] = pm.collectionVariables.get('basicToken').split('.');",
                  "pm.variables.set('attackToken', [h, enc(dec(p).replace('Products.Read', 'Products.Create')), s].join('.'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/product-service/products/create",
            "description": "Payload edited from Products.Read to Products.Create; signature kept. RS256 covers header and payload, so the signature no longer matches.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attackToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"brandId\": {{brandId}}, \"name\": \"Postman widget\", \"description\": \"attack demo\", \"quantity\": 3, \"reOrderThreshold\": 1}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "alg=none token (A3)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "const CryptoJS = require('crypto-js');",
                  "const dec = s => CryptoJS.enc.Base64.parse(s.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((s.length + 3) % 4)).toString(CryptoJS.enc.Utf8);",
                  "const url = b => b.replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const enc = s => url(CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(s)));",
                  "const p = pm.collectionVariables.get('basicToken').split('.')[1];",
                  "pm.variables.set('attackToken', enc('{\"alg\":\"none\",\"typ\":\"JWT\"}') + '.' + p + '.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/product-service/products/all",
            "description": "Header says no signature at all. Validators accept RS256 only.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attackToken}}"
                }
              ]
            }
          }
        },
        {
          "name": "HS256 token signed with the old leaked secret (A4)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "const CryptoJS = require('crypto-js');",
                  "const dec = s => CryptoJS.enc.Base64.parse(s.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((s.length + 3) % 4)).toString(CryptoJS.enc.Utf8);",
                  "const url = b => b.replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const enc = s => url(CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(s)));",
                  "const p = pm.collectionVariables.get('basicToken').split('.')[1];",
                  "const unsigned = enc('{\"alg\":\"HS256\",\"typ\":\"JWT\"}') + '.' + p;",
                  "const sig = url(CryptoJS.enc.Base64.stringify(CryptoJS.HmacSHA256(unsigned, 'ao787VuHniutbig8ob5cf000pju787jlpzDD0')));",
                  "pm.variables.set('attackToken', unsigned + '.' + sig);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/product-service/products/all",
            "description": "The retired HS256 secret is still in git history. A valid HS256 token made with it is rejected: only RS256 is accepted.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{attackToken}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3 Bypass the gateway",
      "description": "Call a service directly on its own port.",
      "item": [
        {
          "name": "Direct call to Product, no client certificate (N1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "const code = pm.response && pm.response.code;",
                  "pm.test('No HTTP response: TLS handshake rejected', () => pm.expect(code, `got HTTP ${code}`).to.be.undefined);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{productDirectUrl}}/api/products/all",
            "description": "Expected: \"Could not get response\" (TLS handshake fails). Product accepts only the client certificate our CA issued to the gateway (mutual TLS). No test runs because there is no response.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4 Forged event",
      "description": "Attacker with RabbitMQ credentials publishes an unsigned event straight to the broker.",
      "item": [
        {
          "name": "Error queue count before",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Queue read (404 = not created yet)', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
                  "pm.collectionVariables.set('errorsBefore', pm.response.code === 404 ? 0 : pm.response.json().messages || 0);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbitUrl}}/api/queues/%2F/ProductCreatedEventQueue_error",
            "description": "Messages in the error queue now. On a new broker the queue does not exist until the first rejected event (404 = 0 messages).",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPassword}}"
                }
              ]
            }
          }
        },
        {
          "name": "Publish unsigned event, quantity 3 (M1)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "const id = 900000 + Math.floor(Math.random() * 99999);",
                  "pm.collectionVariables.set('fakeId', id);",
                  "const envelope = {",
                  "    messageId: pm.variables.replaceIn('{{$guid}}'),",
                  "    messageType: ['urn:message:ResponseLibrary.Models.Requests.Product.Events:ProductCreatedEvent'],",
                  "    message: { Id: id, Name: 'forged', Quantity: 3, ReOrderThreshold: 0 },",
                  "    headers: {} // No X-Signature / X-Signed-At.",
                  "};",
                  "pm.variables.set('eventBody', JSON.stringify({",
                  "    properties: { content_type: 'application/vnd.masstransit+json', headers: {} },",
                  "    routing_key: '', payload: JSON.stringify(envelope), payload_encoding: 'string'",
                  "}));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Broker routed it', () => pm.expect(pm.response.json().routed).to.eql(true));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{rabbitUrl}}/api/exchanges/%2F/ResponseLibrary.Models.Requests.Product.Events:ProductCreatedEvent/publish",
            "description": "RabbitMQ accepts and routes it; the broker does not check signatures. Body is built in the pre-request script.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{{eventBody}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "No stock items for the forged product",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found (no items)', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/inventory-service/items/get-by-product-id/{{fakeId}}",
            "description": "Inventory rejected the event before any consumer ran. Its log: \"Rejected ProductCreatedEvent ...: missing signature\".",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            }
          }
        },
        {
          "name": "Error queue count after",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "setTimeout(() => {}, 6000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "const before = +pm.collectionVariables.get('errorsBefore'), after = pm.response.json().messages || 0;",
                  "console.log(`error queue: ${before} -> ${after}`);",
                  "pm.test(`Error queue grew (${before} -> ${after})`, () => pm.expect(after).to.be.above(before));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{rabbitUrl}}/api/queues/%2F/ProductCreatedEventQueue_error",
            "description": "The rejected event moved to the error queue. Management stats lag about 5 seconds.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{rabbitUser}}"
                },
                {
                  "key": "password",
                  "value": "{{rabbitPassword}}"
                }
              ]
            }
          }
        }
      ]
    },
