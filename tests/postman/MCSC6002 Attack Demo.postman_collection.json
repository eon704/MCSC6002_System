{
  "info": {
    "name": "MCSC6002 Attack Demo",
    "description": "Attack demo for the Secure Microservices Inventory System. Same steps as scripts/demo.sh and a subset of tests/AttackTests.cs.\n\nBefore running:\n1. Start the stack: bash scripts/run.sh (from MCSC6002_System).\n2. Postman Settings > Certificates > CA certificates: add keys/tls/ca.crt (trusts our CA in Postman only). Or turn off SSL certificate verification.\n3. Collection > Variables: fill adminPassword, basicPassword (SEED_ADMIN_PASSWORD, SEED_BASIC_PASSWORD) and rabbitUser, rabbitPassword (RABBITMQ_USER, RABBITMQ_PASSWORD) from .env. Put them in Current value only, never in Initial value, so they are not exported.\n4. Run the folders in order, or use Run collection. Wait a minute between full runs: /auth allows 5 calls per minute per IP.\n\nEvery request has tests; see the Test Results tab. Folder 3 is expected to fail with \"Could not get response\".",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 Setup",
      "description": "Logs in both seeded users and picks a brand. Run first.",
      "item": [
        {
          "name": "Admin logs in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "const CryptoJS = require('crypto-js');",
                  "const dec = s => CryptoJS.enc.Base64.parse(s.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((s.length + 3) % 4)).toString(CryptoJS.enc.Utf8);",
                  "const url = b => b.replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const enc = s => url(CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(s)));",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().data.token;",
                  "pm.collectionVariables.set('adminToken', token);",
                  "const [h, p] = token.split('.');",
                  "const header = JSON.parse(dec(h)), payload = JSON.parse(dec(p));",
                  "console.log('header', header, 'payload', payload);",
                  "pm.test('Signed with RS256', () => pm.expect(header.alg).to.eql('RS256'));",
                  "pm.test('Expires in 15 minutes', () => pm.expect(Math.round((payload.exp - Date.now() / 1000) / 60)).to.be.within(14, 15));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/login",
            "description": "Admin gets an RS256 access token (15 min) and a refresh token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"userName\": \"{{adminUser}}\", \"password\": \"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Basic user logs in",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "const CryptoJS = require('crypto-js');",
                  "const dec = s => CryptoJS.enc.Base64.parse(s.replace(/-/g, '+').replace(/_/g, '/') + '==='.slice((s.length + 3) % 4)).toString(CryptoJS.enc.Utf8);",
                  "const url = b => b.replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const enc = s => url(CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(s)));",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('basicToken', data.token);",
                  "pm.collectionVariables.set('basicRefreshToken', data.refreshToken);",
                  "console.log('basic user permissions', JSON.parse(dec(data.token.split('.')[1])).permission);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/login",
            "description": "Basic user: read permissions only.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"userName\": \"{{basicUser}}\", \"password\": \"{{basicPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Admin creates a brand",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('brandId', pm.response.json().data);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/product-service/brands/create",
            "description": "Brand for the products created later; works on an empty database too.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Postman brand\", \"description\": \"attack demo\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
