    {
      "name": "6 Information disclosure",
      "description": "Response headers reveal nothing and prevent caching.",
      "item": [
        {
          "name": "Security headers (I1, I3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('No Server header', () => pm.response.to.not.have.header('Server'));",
                  "pm.test('No X-Powered-By', () => pm.response.to.not.have.header('X-Powered-By'));",
                  "pm.test('nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
                  "pm.test('same-origin', () => pm.expect(pm.response.headers.get('Cross-Origin-Resource-Policy')).to.eql('same-origin'));",
                  "pm.test('no-store', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));"
                ]
              }
            }
